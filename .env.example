# ============================================================
# X Trends Dashboard 設定
#   cp .env.example .env  してから値を入れてください
#   .env は .gitignore 済み（コミットしないこと）
# ============================================================

# --- データソース -------------------------------------------
# official | twitterapiio | demo
# 未設定なら「X_BEARER_TOKEN があれば official、無ければ demo」で自動判定
TRENDS_PROVIDER=

# 公式 X API v2 の Bearer Token（developer portal / console.x.com で発行）
# GET https://api.x.com/2/trends/by/woeid/{woeid}
X_BEARER_TOKEN=
X_API_BASE=https://api.x.com

# 代替プロバイダ（公式が高すぎる場合の選択肢）
TWITTERAPI_KEY=
TWITTERAPI_BASE=https://api.twitterapi.io

# --- 収集 ---------------------------------------------------
# 何分ごとに取得するか。X 側は概ね5分ごとにトレンドを再計算する。
# 1リクエストごとに課金されるので、間隔を詰めるほどコストが増える。
POLL_INTERVAL=5

# 自動収集する地域（WOEID のカンマ区切り）。空なら全世界+日本+東京+大阪+米国+ロンドン
WATCH_WOEIDS=1,23424856,1118370,15015372

# ポーラーを止めてオンデマンド取得だけにするなら false
POLLER_ENABLED=true

# 初回起動時にデモ履歴（2日分）を作るか。demo プロバイダのときだけ動作。
SEED_HISTORY=true

# --- ストレージ / サーバ -------------------------------------
DB_PATH=./data/trends.db
HISTORY_DAYS=7
MAX_SNAPSHOTS=4000

HOST=127.0.0.1
PORT=8000

# 公開するなら設定推奨。空なら認証なし。
ACCESS_TOKEN=

DEBUG=false
